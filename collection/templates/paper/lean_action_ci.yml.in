name: Lean Action CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read # Read access to repository contents

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # Mathlib's compiled files take most of the runner's disk; remove preinstalled toolchains
      # that the build does not use.
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL
          df -h /
      - uses: actions/checkout@v7
      - uses: leanprover/lean-action@v1
      # formalize-math-paper adds its checks here (its assets/lean_action_ci.yml), with its
      # `ProjectName` the root {{root}}
      # and its `PaperName` the paper {{paper}}:
      # the audit of every module of {{root}}/,
      # of palomar/{{paper}}/Solution.lean
      # and of the libraries this repository requires (lean4-phylogenetics, docs/CONVENTIONS.md,
      # Section 3); the route check of docs/{{paper}}/paper_routes.tsv;
      # the copy of {{root}}/{{paper}}/Defs.lean
      # in palomar/{{paper}}/Challenge.lean; the links and the tables.
