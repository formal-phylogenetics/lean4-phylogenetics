name = "{{root}}"
version = "0.1.0"
keywords = ["math", "phylogenetics"]
description = "{{description}}"
defaultTargets = ["Common", "{{paper}}", "Palomar"]

[leanOptions]
pp.unicode.fun = true
autoImplicit = false
maxSynthPendingDepth = 3

{{requires}}
# Every module of the project is under its root but the Palomar submission's, so that the
# repositories of the collection can require one another (lean4-phylogenetics,
# docs/CONVENTIONS.md, Sections 2 and 3). Lake fails on a glob whose directory does not exist.

# General mathematics and the results the paper cites:
# {{root}}/Common/Basic/ and {{root}}/Common/External/.
[[lean_lib]]
name = "Common"
globs = ["{{root}}.Common.+"]

# The paper's library, in the namespace {{paper}}:
# {{root}}/{{paper}}/.
[[lean_lib]]
name = "{{paper}}"
globs = ["{{root}}.{{paper}}.+"]

# The paper's Challenge and Solution, the modules of the source directory palomar/
# {{paper}}.Challenge and {{paper}}.Solution
# (Comparator: palomar/{{paper}}/comparator.json).
[[lean_lib]]
name = "Palomar"
srcDir = "palomar"
globs = ["{{paper}}.+"]
