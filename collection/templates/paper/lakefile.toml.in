name = "{{root}}"
version = "0.1.0"
keywords = ["math", "phylogenetics"]
description = "{{description}}"
defaultTargets = ["{{root}}", "Palomar"]

[leanOptions]
pp.unicode.fun = true
autoImplicit = false
maxSynthPendingDepth = 3

{{requires}}
# Every module of the project is in {{root}}/, but its Challenge and its Solution, which are in
# palomar/ (lean4-phylogenetics, docs/CONVENTIONS.md, Sections 2 and 3). Lake fails on a glob whose
# directory, or a root whose file, does not exist.

# The paper's library, in the namespace {{paper}}: general mathematics in {{root}}/Basic/, the
# results the paper cites in {{root}}/External/, the definitions of the Challenge in
# {{root}}/Defs.lean, and the paper's sections.
[[lean_lib]]
name = "{{root}}"
globs = ["{{root}}.+"]

# The paper's Challenge and Solution, the modules {{paper}}.Challenge and {{paper}}.Solution of
# the source directory palomar/ (Comparator: palomar/{{paper}}/comparator.json). Declared last:
# Lake gives a module to the last library whose patterns match it, and the glob above matches
# these names when the paper's name is the root.
[[lean_lib]]
name = "Palomar"
srcDir = "palomar"
roots = ["{{paper}}.Challenge", "{{paper}}.Solution"]
